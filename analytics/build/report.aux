\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Table 4.3 (regenerated), overall rows. Relay ``all rows'' covers the full 5{,}365-row dataset. Source: outputs/table\_4\_3 (report 2026-11-12\_19-43-50).}}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Overall detection accuracy with bootstrap SDs. Where it goes: Section 4.x, Table 4.3 discussion. Source: table\_4\_3.csv.}}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces H1 forest plot: accuracy gain over the relay with 95\% CIs; Cochran's Q = 1906.85 (df = 8, $p < 10^{-6}$). Where it goes: Section 4.x, H1. Source: hypothesis results CSV.}}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Per-target accuracy. Per-target Cochran's Q: G: Q = 40.04, C: Q = 60.13, B: Q = 37.68, A: Q = 167.49; under Holm correction the LSTM is significantly best on G/C/B and, with CNN, on phase A. Where it goes: Section 4.x, H2. Source: hypothesis results CSV.}}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Latency and noise robustness (H3, H4)}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Reporting latency (log scale). Every model reports faster than the relay's 10 ms reference by essentially the full margin (Hodges--Lehmann $\approx -10$ ms); the LSTM reports 188.75 ms slower (95\% CI [178.5, 197.0], mean 204.9 ms). Where it goes: Section 4.x, H3 --- replaces the stale ``270 ms'' sentence. Source: table\_4\_3.csv + hypothesis results CSV.}}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Accuracy change vs the 1\% noise baseline, mean across targets. The shaded band is the pre-declared 5 pp TOST equivalence margin: the LSTM is equivalent at every level, KNN up to 10\% on all targets, the others break at 20\%; CNN and PINN are not equivalent on phase A even at 5\%. Where it goes: Section 4.x, H4. Source: robustness\_*.csv (2026-11-12 rows).}}{11}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Fault location and scenario structure (H5, R9)}{11}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces H5 fault-location MAE, recomputed from the Loc columns of the prediction files and asserted against the hypothesis report (within 0.05 pp). Source: predictions\_*.csv.}}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Location MAE ranking. Where it goes: Section 4.x, H5. Source: prediction files (asserted).}}{12}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Per-location MAE. The DTR stays within 0.31--0.63 km of the LSTM at every location (all Holm-adjusted $p < 10^{-6}$); every other model trails by 3.3--30.9 km. Friedman all-locations $\chi ^2$ = 2338.9, Kendall's W = 0.557. Where it goes: Section 4.x, H5. Source: prediction files.}}{12}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Exact type-vector accuracy by fault combination; the relay row is structurally inapplicable (binary trip output) and is omitted. Where it goes: Section 4.x, combination-accuracy discussion. Source: combination results CSV.}}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Scenario-grouped K = 7 CV (descriptive, fixed hyperparameters): detection 0.9914--0.9978, exact match 0.8990--0.9631. Where it goes: Section 3.12.1 / 4.x (R9). Source: cv\_results CSV.}}{13}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces CV means $\pm $ SD across the 7 scenario-grouped folds. Source: outputs/scenario\_cv (report 2026-11-12\_17-25-03).}}{13}{}\protected@file@percent }
